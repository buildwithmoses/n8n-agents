# Copy to .env (gitignored). Never commit real values.
N8N_URL=http://localhost:5678
# n8n UI -> Settings -> n8n API -> Create an API key
N8N_API_KEY=
# https://openrouter.ai/keys (stored as an n8n credential by setup; never written into workflow JSON)
OPENROUTER_API_KEY=
# Shared secret approvers send as the X-Approval-Token header: openssl rand -hex 24
APPROVAL_TOKEN=
# Optional. Each workflow uses its own mock port from mock/ports.json; set MOCK_HOST if the container
# cannot reach host.docker.internal.
# MOCK_HOST=host.docker.internal
